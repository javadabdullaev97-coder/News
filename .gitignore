node_modules
.next
out
.env*.local
.DS_Store
next-env.d.ts
*.tsbuildinfo

# Собирается из content/posts/**/*.mdx через scripts/build-posts.mjs
# (npm-хуки postinstall / predev / prebuild / prelint). В git не хранится,
# чтобы не расходиться с исходными .mdx.
lib/generated-posts.ts

# Постраничный рендер PDF-актов lex.uz — техническая распечатка для чтения,
# не редакционный артефакт
.review/act425-pages/

# Питоновский кеш скриптов — регенерируется на каждом прогоне
scripts/__pycache__/
__pycache__/

# Производный индекс источников — собирается scripts/build-source-index.mjs
# перед каждым использованием. В репозитории не хранится: производный файл
# рядом с исходником рано или поздно расходится с ним, и молча.
config/generated/

# Рабочие черновики reporter/fact-checker/editor внутри одного прогона
# планёрки. Живут только до решения по теме — уходят в content/queue,
# content/needs-verification или content/rejected, сам черновик в git
# не попадает никогда (история это подтверждает).
content/drafts/

# Корпус пайплайна анализа конкурентов: кеш скачанных страниц и очищенные
# тексты чужих изданий. Полностью регенерируется scripts/competitor/*.py.
# В git не хранится: это сотни мегабайт и, главное, чужие тексты целиком —
# в репозиторий идут только агрегаты и цитаты не длиннее 15 слов.
data/
.venv-competitor/

# Выборки для ручного чтения: содержат полные тексты чужих материалов.
# Регенерируются scripts/competitor/sample.py, в git не хранятся —
# в репозиторий идёт только кодировочная таблица output/qualitative.csv.
output/qualitative-sample.json
output/validation-sample.json

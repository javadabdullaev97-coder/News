{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leap",
  "main": "src/worker.ts",
  // Cloudflare Workers Builds запускает `wrangler deploy` без отдельного шага
  // сборки, поэтому каталог `out/` к моменту деплоя не существует и wrangler
  // падает на "assets.directory does not exist". Кастомный build выполняется
  // самим wrangler перед деплоем и закрывает этот разрыв.
  // `npm run build` тянет за собой prebuild -> scripts/build-posts.mjs,
  // который собирает статьи из content/posts/**/*.mdx.
  "build": {
    "command": "npm run build"
  },
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // Внешние часы редакции. Планировщик GitHub измеренно ненадёжен: фетчер
  // выдал 8 запусков за 10 часов вместо 60, сторож heartbeat — 13 за 28 часов
  // вместо 28, с провалами до четырёх часов подряд. Запуск ПО СОБЫТИЮ у того
  // же GitHub отрабатывает за секунды, поэтому расписание переезжает сюда,
  // а GitHub получает repository_dispatch.
  //
  // Тик раз в минуту, а что именно делать — решает worker по минуте часа
  // (см. src/worker.ts, scheduled). Так расписание описано в одном месте
  // и не требует хранилища состояния.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
